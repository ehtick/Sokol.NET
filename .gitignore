
.DS_Store
bin/
!tools/bin/
!ext/ozz-animation/bin/
ext/ozz-animation/bin/*
!ext/ozz-animation/bin/emscripten/
obj/
examples/*/ios/
examples/*/android/
!examples/*/shaders/compiled/ios/
!examples/*/shaders/compiled/android/

# Build outputs (APKs, AABs, IPAs, etc.)
examples/*/output/

# .NET SDK resolver backup temp files (left behind by wasm/browser-wasm builds; the SDK
# writes one per build/restore and never cleans them up)
*.SdkResolver.*.proj.Backup.tmp
