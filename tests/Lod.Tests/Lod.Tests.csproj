<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone logic test for the LOD selector (RENDERING_SERVER_M3_REVIEW.md 3.1 / 3.10 / T8).
    It compiles ONLY the two pure C# Lod source files: no Sokol/native dependency, no
    NativeAOT, no NuGet packages, so it builds and runs offline with just the .NET SDK.
    Run it with "dotnet run" from this folder. Exits 0 on success, 1 on any failed assertion.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1574;CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The classes under test, pulled in directly (no project reference to Framework.dll). -->
    <Compile Include="../../src/Framework/Renderer/Server/Lod/LodSelector.cs" />
    <Compile Include="../../src/Framework/Renderer/Server/Lod/LodGroup.cs" />
  </ItemGroup>

</Project>
